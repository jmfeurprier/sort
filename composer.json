{
    "name": "jmf/sort",
    "description" : "Sort arrays by key, property, etc.",
    "license": "mit",
    "type": "library",
    "require": {
        "php": ">=8.3",
        "symfony/property-access": "^6.0|^7.0|^8.0",
        "webmozart/assert": "^1.0|^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Sort\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Sort\\": "tests/unit/src"
        }
    }
}
